{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskSpan Screen",
  "version": "0.1.0",
  "identifier": "app.deskspan.screen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "DeskSpan Screen", "fullscreen": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws: http:; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../src-tauri/icons/32x32.png", "../../src-tauri/icons/128x128.png", "../../src-tauri/icons/128x128@2x.png", "../../src-tauri/icons/icon.icns", "../../src-tauri/icons/icon.ico", "../../src-tauri/icons/icon.png"],
    "iOS": { "minimumSystemVersion": "15.0" },
    "android": { "minSdkVersion": 26 }
  }
}
